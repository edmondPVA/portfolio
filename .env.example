# Copy this file to ".env" for any server-side tooling. Never commit the real ".env".
# The website itself is static and reads only the PUBLIC values in admin/config.js.

# Public (safe in front-end code; protected by Row Level Security)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# PRIVATE: server-side only. Never put these in front-end JavaScript or public GitHub files.
# Needed later for email replies (Supabase Edge Function secrets, not this repo).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-goes-here
EMAIL_PROVIDER_API_KEY=your-email-provider-key-goes-here
